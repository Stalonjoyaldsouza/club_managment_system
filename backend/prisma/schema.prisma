generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum BorrowStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectRole {
  LEAD
  CONTRIBUTOR
  REVIEWER
}

enum EventType {
  HACKATHON
  WORKSHOP
  MEETING
  COMPETITION
  SOCIAL
  OTHER
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum EmailStatus {
  SENT
  FAILED
  DRAFT
}

enum EmailCategory {
  PERMISSION
  ANNOUNCEMENT
  REMINDER
  OTHER
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole    @default(MEMBER)
  joinedAt     DateTime    @default(now())
  avatarUrl    String?
  member       ClubMember?
}

model ClubMember {
  id                   String               @id @default(cuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  position             String
  department           String
  isActive             Boolean              @default(true)
  joinedClubAt         DateTime             @default(now())
  markedAttendance     AttendanceRecord[]   @relation("MarkedAttendance")
  attendanceRecords    AttendanceRecord[]   @relation("MemberAttendance")
  addedInventory       InventoryItem[]
  borrowedRequests     BorrowRequest[]      @relation("Borrower")
  approvedRequests     BorrowRequest[]      @relation("Approver")
  createdProjects      Project[]
  projectMemberships   ProjectMember[]
  createdEvents        Event[]
  eventParticipations  EventParticipant[]
  sentEmails           EmailLog[]
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  memberId   String
  member     ClubMember       @relation("MemberAttendance", fields: [memberId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  date       DateTime
  status     AttendanceStatus
  markedById String
  markedBy   ClubMember       @relation("MarkedAttendance", fields: [markedById], references: [id])
}

model InventoryItem {
  id                String          @id @default(cuid())
  name              String
  description       String
  category          String
  totalQuantity     Int
  availableQuantity Int
  imageUrl          String?
  addedById         String
  addedBy           ClubMember      @relation(fields: [addedById], references: [id])
  createdAt         DateTime        @default(now())
  borrowRequests    BorrowRequest[]
}

model BorrowRequest {
  id           String       @id @default(cuid())
  itemId       String
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  borrowerId   String
  borrower     ClubMember   @relation("Borrower", fields: [borrowerId], references: [id])
  approvedById String?
  approvedBy   ClubMember?  @relation("Approver", fields: [approvedById], references: [id])
  quantity     Int
  borrowedAt   DateTime     @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  status       BorrowStatus @default(PENDING)
  purpose      String
  notes        String?
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String
  status      ProjectStatus   @default(PLANNING)
  startDate   DateTime
  endDate     DateTime?
  createdById String
  createdBy   ClubMember      @relation(fields: [createdById], references: [id])
  githubUrl   String?
  tags        String[]
  members     ProjectMember[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    ClubMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role      ProjectRole
  joinedAt  DateTime    @default(now())

  @@unique([projectId, memberId])
}

model Event {
  id                String              @id @default(cuid())
  name              String
  description       String
  type              EventType
  venue             String
  startDate         DateTime
  endDate           DateTime
  status            EventStatus         @default(UPCOMING)
  createdById       String
  createdBy         ClubMember          @relation(fields: [createdById], references: [id])
  registrationLink  String?
  bannerUrl         String?
  maxParticipants   Int?
  teamFormation     String?
  projectSubmission String?
  prizeDetails      String?
  participants      EventParticipant[]
  attendanceRecords AttendanceRecord[]
}

model EventParticipant {
  id           String     @id @default(cuid())
  eventId      String
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId     String
  member       ClubMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  registeredAt DateTime   @default(now())
  attended     Boolean    @default(false)

  @@unique([eventId, memberId])
}

model EmailLog {
  id          String        @id @default(cuid())
  subject     String
  body        String
  recipients  String[]
  sentById    String
  sentBy      ClubMember    @relation(fields: [sentById], references: [id])
  sentAt      DateTime      @default(now())
  status      EmailStatus
  category    EmailCategory
  aiGenerated Boolean       @default(false)
}
